FROM python:3.13-slim-bookworm@sha256:00faa2debb87529f9f0764e9491d8ba400a3678976616c3bd7cb193745ac20d1

ARG PUBLIC_TREE_SHA256

LABEL org.omp.rolebench.task.role="designer" \
      org.omp.rolebench.task.stage="runner" \
      org.omp.rolebench.task.public-tree-sha256="${PUBLIC_TREE_SHA256}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium=151.0.7922.137-1~deb12u1 \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /workspace /workspace/rolebench-home \
 && chown -R 1000:1000 /workspace \
 && chmod -R 0777 /workspace

COPY public/ /opt/rolebench/task/public/
COPY runner.py /usr/local/bin/rolebench-task-runner
RUN chmod -R a+rX /opt/rolebench/task/public \
 && chmod 0555 /usr/local/bin/rolebench-task-runner

USER 1000:1000
ENTRYPOINT ["/usr/local/bin/rolebench-task-runner"]
