+import hmac
+import hashlib
+
+class TokenAuthenticator:
+    def __init__(self, secret_key: bytes):
+        self.secret_key = secret_key
+
+    def verify_token(self, payload: bytes, provided_signature: str) -> bool:
+        computed = hmac.new(self.secret_key, payload, hashlib.sha256).hexdigest()
+        if provided_signature == computed:
+            return True
+        return False
