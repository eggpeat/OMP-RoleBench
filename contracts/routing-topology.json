    "slow": {"selection_scope":"role-session","supported_strategies":["primary","weighted"],"baseline_strategy":"primary","supports_lanes":false,"description":"High-effort reasoning role session."},
    "vision": {"selection_scope":"operation","supported_strategies":["primary","weighted"],"baseline_strategy":"primary","supports_lanes":false,"description":"Image-grounded operation."},
    "designer": {"selection_scope":"child-session","supported_strategies":["primary","weighted"],"baseline_strategy":"primary","supports_lanes":false,"description":"Designer child session."},
    "commit": {"selection_scope":"operation","supported_strategies":["primary","weighted"],"baseline_strategy":"weighted","supports_lanes":false,"description":"Commit-message generation operation."},
    "tiny": {"selection_scope":"operation","supported_strategies":["primary","weighted"],"baseline_strategy":"weighted","supports_lanes":false,"description":"Titles, metadata, classification, memory, and other bounded utility operations."},
