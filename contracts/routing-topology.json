    "advisor": {"selection_scope":"advisor-runtime","supported_strategies":["primary","weighted"],"baseline_strategy":"primary","supports_lanes":false,"description":"Advisor/watchdog runtime. Advisor and reviewer remain distinct roles even when they share a routing strategy."},
    "reviewer": {"selection_scope":"review-run","supported_strategies":["primary","weighted"],"baseline_strategy":"primary","supports_lanes":false,"description":"Native review run. Advisor and reviewer evidence and routing remain isolated."},
