{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:worker-run-manifest:v2",
  "title": "RoleBench Worker Run Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "role", "task", "policy", "provider", "agent", "runner", "verifier"],
  "properties": {
    "schema_version": {"const": "omp.worker-run-manifest/v2"},
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "role": {
      "enum": ["default", "smol", "slow", "vision", "plan", "designer", "commit", "tiny", "task", "advisor", "reviewer"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest_sha256"],
      "properties": {
        "digest_sha256": {"$ref": "#/$defs/sha256"},
        "qualification_digest_sha256": {"$ref": "#/$defs/sha256"},
        "public_tree_digest_sha256": {"$ref": "#/$defs/sha256"},
        "verifier_private_tree_digest_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_use": {"enum": ["admission-only", "calibration-only"]}
      },
      "dependentRequired": {
        "qualification_digest_sha256": ["public_tree_digest_sha256", "verifier_private_tree_digest_sha256", "evidence_use"],
        "public_tree_digest_sha256": ["verifier_private_tree_digest_sha256", "evidence_use"],
        "verifier_private_tree_digest_sha256": ["public_tree_digest_sha256", "evidence_use"],
        "evidence_use": ["public_tree_digest_sha256", "verifier_private_tree_digest_sha256"]
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"const": false}
      }
    },
    "agent": {"$ref": "#/$defs/container"},
    "runner": {"$ref": "#/$defs/container"},
    "verifier": {"$ref": "#/$defs/container"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "properties": {
              "evidence_use": {"const": "admission-only"}
            },
            "required": ["evidence_use"]
          }
        },
        "required": ["task"]
      },
      "then": {
        "properties": {
          "task": {
            "not": {"required": ["qualification_digest_sha256"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "properties": {
              "evidence_use": {"const": "calibration-only"}
            },
            "required": ["evidence_use"]
          }
        },
        "required": ["task"]
      },
      "then": {
        "properties": {
          "task": {
            "required": ["qualification_digest_sha256"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[^-\\s@][^\\s@]*@sha256:[0-9a-f]{64}$"
    },
    "argument": {
      "type": "string",
      "pattern": "^[^\\u0000]*$"
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "config_digest_sha256", "platform", "argv"],
      "properties": {
        "image": {"$ref": "#/$defs/image"},
        "config_digest_sha256": {"$ref": "#/$defs/sha256"},
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture", "variant"],
          "properties": {
            "os": {"const": "linux"},
            "architecture": {"enum": ["amd64", "arm64"]},
            "variant": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/argument"}, {"minLength": 1}]}
          ],
          "items": {"$ref": "#/$defs/argument"}
        }
      }
    }
  }
}
