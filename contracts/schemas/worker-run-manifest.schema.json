{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:worker-run-manifest:v1",
  "title": "RoleBench Worker Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "role", "task", "policy", "provider", "agent", "verifier"],
  "properties": {
    "schema_version": {"const": "omp.worker-run-manifest/v1"},
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "role": {
      "enum": ["default", "smol", "slow", "vision", "plan", "designer", "commit", "tiny", "task", "advisor"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest_sha256"],
      "properties": {
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"const": false}
      }
    },
    "agent": {"$ref": "#/$defs/container"},
    "verifier": {"$ref": "#/$defs/container"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
    },
    "argument": {
      "type": "string",
      "pattern": "^[^\\u0000]*$"
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "argv"],
      "properties": {
        "image": {"$ref": "#/$defs/image"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/argument"}, {"minLength": 1}]}
          ],
          "items": {"$ref": "#/$defs/argument"}
        }
      }
    }
  }
}
