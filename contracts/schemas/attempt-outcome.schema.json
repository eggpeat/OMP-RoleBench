{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:attempt-outcome:v2",
  "title": "RoleBench Attempt Outcome v2",
  "$comment": "Deterministic accounting decision for one attempt. Only valid, scored accepted or rejected outcomes affect model quality.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "observation_digest_sha256", "attempt", "stage", "model_outcome", "verifier_outcome", "failure_domain", "disposition", "valid_attempt", "counts_toward_quality", "reason_code", "termination", "digests"],
  "properties": {
    "schema_version": {"const": "omp.attempt-outcome/v2"},
    "observation_id": {"type": "string", "minLength": 1},
    "observation_digest_sha256": {"$ref": "#/$defs/sha256"},
    "attempt": {"$ref": "#/$defs/attempt"},
    "stage": {"enum": ["queued", "environment", "agent", "artifact", "runner", "runner-evidence", "verifier", "complete"]},
    "model_outcome": {"enum": ["accepted", "rejected", "no-valid-attempt"]},
    "verifier_outcome": {"enum": ["accepted", "rejected", "indeterminate", "error"]},
    "failure_domain": {
      "enum": [
        "none",
        "model_task",
        "verifier",
        "runner_harness",
        "environment_image",
        "dependency_download",
        "provider_api",
        "timeout_model_deadline",
        "timeout_orchestrator",
        "external_cancellation",
        "policy_sandbox",
        "integrity",
        "suspected_reward_hacking",
        "experiment_scope"
      ]
    },
    "disposition": {"enum": ["scored", "retryable-invalid", "quarantined", "cancelled", "excluded"]},
    "valid_attempt": {"type": "boolean"},
    "counts_toward_quality": {"type": "boolean"},
    "reason_code": {
      "enum": [
        "verifier-accepted",
        "verifier-rejected",
        "model-deadline",
        "attempt-resource-limit",
        "operator-cancelled",
        "suspected-reward-hacking",
        "sandbox-violation",
        "artifact-tampering",
        "integrity-failed",
        "integrity-unknown",
        "environment-startup",
        "image-pull",
        "broken-entrypoint",
        "dependency-setup",
        "runner-failure",
        "artifact-collection",
        "provider-rate-limit",
        "provider-server-error",
        "provider-auth-error",
        "provider-network-error",
        "runtime-incompatible",
        "host-resource-exhaustion",
        "orchestrator-timeout",
        "verifier-crash",
        "verifier-result-missing",
        "verifier-result-malformed",
        "verifier-unhealthy",
        "incomplete-observation",
        "non-scored-evidence"
      ]
    },
    "termination": {"$ref": "#/$defs/termination"},
    "evidence_use": {"enum": ["admission-only", "calibration-only"]},
    "digests": {"$ref": "#/$defs/digests"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_use": {"const": "admission-only"}
        },
        "required": ["evidence_use"]
      },
      "then": {
        "properties": {
          "digests": {
            "required": [
              "task_public_tree",
              "verifier_private_tree",
              "agent_image_config",
              "runner_image_config",
              "verifier_image_config"
            ],
            "not": {"required": ["qualification"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_use": {"const": "calibration-only"}
        },
        "required": ["evidence_use"]
      },
      "then": {
        "properties": {
          "digests": {
            "required": [
              "qualification",
              "task_public_tree",
              "verifier_private_tree",
              "agent_image_config",
              "runner_image_config",
              "verifier_image_config"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "number", "previous_attempt_id"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "number": {"type": "integer", "minimum": 1},
        "previous_attempt_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "exit_code", "signal", "oom_scope"],
      "properties": {
        "kind": {"enum": ["completed", "model-deadline", "orchestrator-timeout", "resource-limit", "operator-cancelled", "signal", "unknown"]},
        "exit_code": {"type": ["integer", "null"]},
        "signal": {"type": ["integer", "null"], "minimum": 1},
        "oom_scope": {"enum": ["none", "attempt", "host", "unknown"]}
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "config", "agent_image", "runner_image", "verifier_image", "runtime_policy", "artifact", "runner_evidence", "trajectory"],
      "properties": {
        "task": {"$ref": "#/$defs/sha256"},
        "config": {"$ref": "#/$defs/sha256"},
        "agent_image": {"$ref": "#/$defs/sha256"},
        "runner_image": {"$ref": "#/$defs/sha256"},
        "verifier_image": {"$ref": "#/$defs/sha256"},
        "runtime_policy": {"$ref": "#/$defs/sha256"},
        "artifact": {"$ref": "#/$defs/nullableSha256"},
        "runner_evidence": {"$ref": "#/$defs/nullableSha256"},
        "trajectory": {"$ref": "#/$defs/nullableSha256"},
        "qualification": {"$ref": "#/$defs/sha256"},
        "task_public_tree": {"$ref": "#/$defs/sha256"},
        "verifier_private_tree": {"$ref": "#/$defs/sha256"},
        "agent_image_config": {"$ref": "#/$defs/sha256"},
        "runner_image_config": {"$ref": "#/$defs/sha256"},
        "verifier_image_config": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
