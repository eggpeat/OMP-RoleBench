{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:experiment-ledger-entry:v1",
  "title": "RoleBench Local Experiment Ledger Entry v1",
  "description": "Local append-only evidence transport. It is non-authoritative and cannot grant task admission or routing eligibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "sequence", "timestamp", "previous_entry_sha256", "payload_schema", "payload_digest_sha256", "payload"],
  "properties": {
    "schema_version": {"const": "omp.experiment-ledger-entry/v1"},
    "authority": {"const": "local-non-authoritative"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "timestamp": {"type": "string", "format": "date-time"},
    "previous_entry_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "payload_schema": {"enum": ["attempt-observation", "attempt-outcome", "evidence-row", "task-qualification"]},
    "payload_digest_sha256": {"$ref": "#/$defs/sha256"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"sequence": {"const": 0}}, "required": ["sequence"]}, "then": {"properties": {"previous_entry_sha256": {"type": "null"}}}, "else": {"properties": {"previous_entry_sha256": {"$ref": "#/$defs/sha256"}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
