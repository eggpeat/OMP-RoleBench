{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:verifier-result:v1",
  "title": "RoleBench Verifier Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_nonce",
    "outcome",
    "reward",
    "artifact_digest_sha256",
    "runner_evidence_digest_sha256",
    "evaluation_request_digest_sha256",
    "verifier_image_digest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "omp.verifier-result/v1"},
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "attempt_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": ["accepted", "rejected", "error"]
    },
    "reward": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "artifact_digest_sha256": {"$ref": "#/$defs/sha256"},
    "runner_evidence_digest_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_request_digest_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_image_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "accepted"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {"reward": {"const": 1}}
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "rejected"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "reward": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "error"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {"reward": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
