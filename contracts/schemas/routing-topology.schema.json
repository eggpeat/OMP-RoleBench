{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:routing-topology:v1",
  "title": "OMP Native Routing Topology v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topology_id", "roles"],
  "properties": {
    "schema_version": {"const": "omp.routing-topology/v1"},
    "topology_id": {"type": "string", "minLength": 1},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "plan", "advisor", "reviewer", "smol", "slow", "vision", "designer", "commit", "tiny", "task"],
      "properties": {
        "default": {"$ref": "#/$defs/manual"},
        "plan": {"$ref": "#/$defs/fallbackRoleSession"},
        "advisor": {"$ref": "#/$defs/fallbackAdvisor"},
        "reviewer": {"$ref": "#/$defs/fallbackReviewer"},
        "smol": {"$ref": "#/$defs/poolOperation"},
        "slow": {"$ref": "#/$defs/fallbackRoleSession"},
        "vision": {"$ref": "#/$defs/fallbackOperation"},
        "designer": {"$ref": "#/$defs/fallbackChildSession"},
        "commit": {"$ref": "#/$defs/poolOperation"},
        "tiny": {"$ref": "#/$defs/poolOperation"},
        "task": {"$ref": "#/$defs/poolChildSession"}
      }
    }
  },
  "$defs": {
    "description": {"type": "string", "minLength": 1},
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "pool_eligible", "selection_scope", "description"],
      "properties": {
        "strategy": {"const": "manual"},
        "pool_eligible": {"const": false},
        "selection_scope": {"const": "main-session"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "fallbackRoleSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "pool_eligible", "selection_scope", "description"],
      "properties": {
        "strategy": {"const": "fallback-chain"},
        "pool_eligible": {"const": false},
        "selection_scope": {"const": "role-session"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "fallbackOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "pool_eligible", "selection_scope", "description"],
      "properties": {
        "strategy": {"const": "fallback-chain"},
        "pool_eligible": {"const": false},
        "selection_scope": {"const": "operation"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "fallbackChildSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "pool_eligible", "selection_scope", "description"],
      "properties": {
        "strategy": {"const": "fallback-chain"},
        "pool_eligible": {"const": false},
        "selection_scope": {"const": "child-session"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "fallbackAdvisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "pool_eligible", "selection_scope", "description"],
      "properties": {
        "strategy": {"const": "fallback-chain"},
        "pool_eligible": {"const": false},
        "selection_scope": {"const": "advisor-runtime"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "fallbackReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "pool_eligible", "selection_scope", "description"],
      "properties": {
        "strategy": {"const": "fallback-chain"},
        "pool_eligible": {"const": false},
        "selection_scope": {"const": "review-run"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "poolOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "pool_eligible", "selection_scope", "description"],
      "properties": {
        "strategy": {"const": "weighted-pool"},
        "pool_eligible": {"const": true},
        "selection_scope": {"const": "operation"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "poolChildSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "pool_eligible", "selection_scope", "description"],
      "properties": {
        "strategy": {"const": "weighted-pool"},
        "pool_eligible": {"const": true},
        "selection_scope": {"const": "child-session"},
        "description": {"$ref": "#/$defs/description"}
      }
    }
  }
}
