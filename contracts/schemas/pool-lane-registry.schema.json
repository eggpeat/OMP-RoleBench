{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:pool-lane-registry:v1",
  "title": "OMP Task Pool Lane Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "lanes"
  ],
  "properties": {
    "schema_version": {
      "const": "omp.pool-lane-registry/v1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "lanes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^task/[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "name",
          "description",
          "routing_traits",
          "complexity",
          "inheritance",
          "status"
        ],
        "properties": {
          "role": {
            "const": "task"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "routing_traits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "complexity": {
            "enum": [
              "easy",
              "medium",
              "hard",
              "expert"
            ]
          },
          "inheritance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when_evidence_insufficient",
              "min_direct_samples",
              "minimum_regret_reduction"
            ],
            "properties": {
              "when_evidence_insufficient": {
                "const": "role-default"
              },
              "min_direct_samples": {
                "type": "integer",
                "minimum": 1
              },
              "minimum_regret_reduction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          }
        }
      }
    }
  }
}
