{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:role-contract:v1",
  "title": "OMP Role Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "role", "display_name", "diagnostic_contract", "required_capabilities", "primary_metric", "secondary_metrics", "verifier", "failure_cost", "stickiness_scope", "task_mix", "thresholds"],
  "properties": {
    "schema_version": {"const": "omp.role-contract/v1"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*/v1$"},
    "role": {"enum": ["default", "smol", "slow", "vision", "plan", "designer", "commit", "tiny", "task", "advisor"]},
    "display_name": {"type": "string", "minLength": 1},
    "diagnostic_contract": {"type": "string", "minLength": 1},
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "primary_metric": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "secondary_metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_required", "modes", "llm_judge"],
      "properties": {
        "objective_required": {"type": "boolean"},
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "llm_judge": {"enum": ["supplemental", "disallowed"]}
      }
    },
    "failure_cost": {"enum": ["low", "medium", "high", "critical"]},
    "stickiness_scope": {"enum": ["main-session", "child-session", "operation"]},
    "task_mix": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v1$"},
    "thresholds": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "quality_floor", "reliability_floor", "confidence", "latency_slo_seconds"],
          "properties": {
            "status": {"const": "calibration-required"},
            "quality_floor": {"type": "null"},
            "reliability_floor": {"type": "null"},
            "confidence": {"type": "null"},
            "latency_slo_seconds": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "quality_floor", "reliability_floor", "confidence", "latency_slo_seconds"],
          "properties": {
            "status": {"const": "frozen"},
            "quality_floor": {"type": "number", "minimum": 0, "maximum": 1},
            "reliability_floor": {"type": "number", "minimum": 0, "maximum": 1},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "latency_slo_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ]
    }
  }
}
