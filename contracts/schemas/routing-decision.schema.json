{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:routing-decision:v1",
  "title": "Routing Decision Event v1",
  "$comment": "candidate route_id and non-null rank values, fallback_ranking route IDs, and attempted_routes are semantically unique; selected and override routes must reference eligible policy routes unless recovery semantics explicitly apply.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "decided_at", "mode", "policy_id", "policy_checksum_sha256", "role", "routing_key_hash", "health_epoch", "capacity_epoch", "explicit_override", "candidates", "selected_route", "fallback_ranking", "recovery", "omp_version"],
  "properties": {
    "schema_version": {"const": "omp.routing-decision/v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["shadow", "enforce"]},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {"enum": ["default", "smol", "slow", "vision", "plan", "designer", "commit", "tiny", "task", "advisor"]},
    "routing_key_hash": {
      "$comment": "Privacy-safe one-way routing key hash; raw routing keys are forbidden by the closed schema.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "health_epoch": {"type": "string", "minLength": 1},
    "capacity_epoch": {"type": "string", "minLength": 1},
    "explicit_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "route_id"],
      "properties": {
        "active": {"type": "boolean"},
        "route_id": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"active": {"const": false}}, "required": ["active"]}, "then": {"properties": {"route_id": {"type": "null"}}}},
        {"if": {"properties": {"active": {"const": true}}, "required": ["active"]}, "then": {"properties": {"route_id": {"type": "string", "minLength": 1}}}}
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "weight_bps", "eligible", "reason_codes", "rank", "rendezvous_hash"],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "weight_bps": {"type": "integer", "minimum": 1, "maximum": 10000},
          "eligible": {"type": "boolean"},
          "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "rank": {"type": ["integer", "null"], "minimum": 1},
          "rendezvous_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"eligible": {"const": true}}, "required": ["eligible"]},
            "then": {
              "properties": {
                "rank": {"type": "integer", "minimum": 1},
                "rendezvous_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
              }
            }
          },
          {
            "if": {"properties": {"eligible": {"const": false}}, "required": ["eligible"]},
            "then": {
              "properties": {
                "rank": {"type": "null"},
                "rendezvous_hash": {"type": "null"}
              }
            }
          }
        ]
      }
    },
    "selected_route": {"type": ["string", "null"], "minLength": 1},
    "fallback_ranking": {
      "$comment": "Explicit emergency fallback order, not the deterministic allocation rank.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempted_routes", "selected_route", "reason"],
      "properties": {
        "status": {"enum": ["not-needed", "pending", "succeeded", "failed"]},
        "attempted_routes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selected_route": {"type": ["string", "null"], "minLength": 1},
        "reason": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "omp_version": {"type": "string", "minLength": 1}
  }
}
