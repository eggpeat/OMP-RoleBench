{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:role-registry:v1",
  "title": "OMP Role Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "roles", "contracts", "task_packs"],
  "properties": {
    "schema_version": {"const": "omp.role-registry/v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "path", "symbol"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"const": "default"}, {"const": "smol"}, {"const": "slow"}, {"const": "vision"}, {"const": "plan"},
        {"const": "designer"}, {"const": "commit"}, {"const": "tiny"}, {"const": "task"}, {"const": "advisor"}
      ],
      "items": false
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "smol", "slow", "vision", "plan", "designer", "commit", "tiny", "task", "advisor"],
      "properties": {
        "default": {"const": "contracts/roles/default.json"},
        "smol": {"const": "contracts/roles/smol.json"},
        "slow": {"const": "contracts/roles/slow.json"},
        "vision": {"const": "contracts/roles/vision.json"},
        "plan": {"const": "contracts/roles/plan.json"},
        "designer": {"const": "contracts/roles/designer.json"},
        "commit": {"const": "contracts/roles/commit.json"},
        "tiny": {"const": "contracts/roles/tiny.json"},
        "task": {"const": "contracts/roles/task.json"},
        "advisor": {"const": "contracts/roles/advisor.json"}
      }
    },
    "task_packs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "smol", "slow"],
      "properties": {
        "task": {"const": "contracts/task-packs/task-v1.json"},
        "smol": {"const": "contracts/task-packs/smol-v1.json"},
        "slow": {"const": "contracts/task-packs/slow-v1.json"}
      }
    }
  }
}
