{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-rolebench:schema:demand-snapshot:v1",
  "title": "Role Demand Forecast Snapshot v1",
  "$comment": "roles may contain any nonempty subset of the supported roles; role values are semantically unique.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "created_at", "forecast_interval", "forecast_source", "roles", "checksum_sha256"],
  "properties": {
    "schema_version": {"const": "omp.demand-snapshot/v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "forecast_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": {"type": "string", "format": "date-time"},
        "ends_at": {"type": "string", "format": "date-time"}
      }
    },
    "forecast_source": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "expected", "lower", "upper", "unit"],
        "properties": {
          "role": {"enum": ["default", "smol", "slow", "vision", "plan", "designer", "commit", "tiny", "task", "advisor", "reviewer"]},
          "expected": {"type": "number", "minimum": 0},
          "lower": {"type": "number", "minimum": 0},
          "upper": {"type": "number", "minimum": 0},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    },
    "checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
