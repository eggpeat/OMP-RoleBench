    "end-to-end-latency",
    "token-consumption",
    "tool-action-count",
    "scope-adherence"
  ],
  "verifier": {
    "objective_required": true,
    "modes": [
      "exact-output-check",
      "artifact-diff-check",
      "resource-trace-check"
    ],
    "llm_judge": "disallowed"
  },
  "failure_cost": "medium",
  "stickiness_scope": "operation",
  "task_mix": "smol-v1",
  "thresholds": {
    "status": "calibration-required",
    "quality_floor": null,
    "reliability_floor": null,
    "confidence": null,
    "latency_slo_seconds": null
  }
}
