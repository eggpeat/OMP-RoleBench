{
  "schema_version": "omp.role-contract/v1",
  "contract_id": "role-contract/reviewer/v1",
  "role": "reviewer",
  "display_name": "Native Structured Code Review",
  "diagnostic_contract": "OMP-native code review that evaluates bounded diffs and changesets, identifies material bugs, regressions, security flaws, and contract violations with exact file and line references, provides actionable reproduction/remediation, and strictly controls false positives on clean or idiomatic code.",
  "required_capabilities": [
    "code-review",
    "defect-recall",
    "false-positive-control",
    "structured-findings",
    "evidence-citation"
  ],
  "primary_metric": "review-accuracy-score",
  "secondary_metrics": [
    "false-positive-rate",
    "location-precision",
    "severity-calibration",
    "schema-adherence"
  ],
  "verifier": {
    "objective_required": true,
    "modes": [
      "seeded-defect-recall",
      "clean-change-precision",
      "structured-output-validation"
    ],
    "llm_judge": "disallowed"
  },
  "failure_cost": "high",
  "stickiness_scope": "child-session",
  "task_mix": "reviewer-v1",
  "thresholds": {
    "status": "calibration-required",
    "quality_floor": null,
    "reliability_floor": null,
    "confidence": null,
    "latency_slo_seconds": null
  }
}
